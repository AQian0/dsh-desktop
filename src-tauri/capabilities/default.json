{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-image"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
